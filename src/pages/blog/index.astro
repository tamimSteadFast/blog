---
/**
 * Blog listing, page 1 (/blog/). Pages 2+ live at /blog/page/N/ — splitting
 * pagination out of this route avoids a rest-param collision with the article
 * route /blog/[...slug]. See docs/PROJECT_ARCHITECTURE.md.
 */
import { getIndexableArticles, PAGE_SIZE } from '@lib/content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleGrid from '@components/blog/ArticleGrid.astro';
import Pager from '@components/blog/Pager.astro';
import { SITE } from '@lib/site';

const all = await getIndexableArticles();
const items = all.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));

const meta = {
  title: `All reviews & guides — ${SITE.name}`,
  description:
    'Every air purifier review, comparison, roundup, and guide on Caliper Air, newest first.',
  path: '/blog/',
};
---
<BaseLayout meta={meta}>
  <div class="grid gap-6">
    <header class="grid gap-2">
      <h1 class="m-0 text-2xl">All reviews & guides</h1>
      <p class="m-0" style="color:var(--color-muted)">Newest first.</p>
    </header>
    <ArticleGrid articles={items} />
    <Pager
      current={1}
      total={totalPages}
      nextHref={totalPages > 1 ? '/blog/page/2/' : undefined}
    />
  </div>
</BaseLayout>
