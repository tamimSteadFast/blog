---
/**
 * Client-side affiliate tracking (Section 7). Two behaviours, both routed
 * through the guarded `pushEvent` in src/lib/analytics.ts (no-op without GTM):
 *
 *   1. `affiliate_click` — a SINGLE delegated listener reads data-* attributes
 *      from any clicked `[data-affiliate]` element. No inline onclick handlers,
 *      and it never modifies the href or delays navigation.
 *   2. `view_product_card` — an IntersectionObserver fires once per product
 *      card when it first enters the viewport.
 *
 * Scroll-depth (25/50/75/90%) is handled by GTM's built-in Scroll Depth
 * trigger — no code here; see docs/GTM_GA4_SETUP.md.
 *
 * This component renders no markup; it only ships the listener. Include it once
 * per page (BaseLayout does this).
 */
---
<script>
  import { pushEvent } from '@lib/analytics';

  // 1. Delegated affiliate-click listener (capture-phase so it runs before
  //    navigation). Reads data-* attributes; never touches the href.
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target as Element | null;
      const link = target?.closest<HTMLAnchorElement>('a[data-affiliate]');
      if (!link) return;
      pushEvent({
        event: 'affiliate_click',
        affiliate_program: 'amazon',
        link_url: link.href,
        link_text: (link.textContent || '').trim().replace(/\s+/g, ' '),
        article_path: window.location.pathname,
        product_asin: link.dataset.asin || '',
        link_position: link.dataset.linkPosition || 'inline',
      });
    },
    { capture: true }
  );

  // 2. Product-card impressions. Fire once per card.
  const cards = document.querySelectorAll<HTMLElement>('[data-product-card]');
  if (cards.length && 'IntersectionObserver' in window) {
    const seen = new WeakSet<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || seen.has(entry.target)) continue;
          seen.add(entry.target);
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          pushEvent({
            event: 'view_product_card',
            product_asin: el.dataset.asin || '',
            article_path: window.location.pathname,
            link_position: el.dataset.linkPosition || 'product_card',
          });
        }
      },
      { threshold: 0.5 }
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
