---
/**
 * Prev/next pagination controls with crawlable <a href> links. Renders nothing
 * when there is only one page.
 */
interface Props {
  prevHref?: string;
  nextHref?: string;
  current: number;
  total: number;
}
const { prevHref, nextHref, current, total } = Astro.props;
---
{total > 1 && (
  <nav class="flex items-center justify-between gap-4 pt-4" aria-label="Pagination">
    {prevHref ? (
      <a class="btn" href={prevHref} rel="prev">← Newer</a>
    ) : (
      <span></span>
    )}
    <span class="text-sm" style="color:var(--color-muted)">Page {current} of {total}</span>
    {nextHref ? (
      <a class="btn" href={nextHref} rel="next">Older →</a>
    ) : (
      <span></span>
    )}
  </nav>
)}
