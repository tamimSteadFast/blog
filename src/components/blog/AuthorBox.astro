---
/**
 * Author box (Caliper / E-E-A-T). Appears at the end of every article and feeds
 * the Person schema. Expertise claims must be true — this box is the difference
 * between a review site and a doorway page.
 */
import { Image } from 'astro:assets';
import type { Author } from '@lib/content';

interface Props {
  author: Author;
}
const { author } = Astro.props;
const initials = author.name
  .split(' ')
  .map((p) => p[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---
<aside class="card flex items-start gap-4 p-5" aria-label={`About ${author.name}`}>
  {author.avatar ? (
    <Image
      src={author.avatar}
      alt={author.name}
      width={64}
      height={64}
      loading="lazy"
      class="h-16 w-16 flex-none rounded-full object-cover"
    />
  ) : (
    <span
      class="flex h-16 w-16 flex-none items-center justify-center rounded-full text-lg font-bold"
      style="background:var(--color-petrol);color:var(--color-petrol-ink)"
      aria-hidden="true"
    >
      {initials}
    </span>
  )}
  <div class="grid gap-1">
    <h2 class="m-0 text-lg">
      <a href={author.href} style="color:var(--color-ink);text-decoration:none">{author.name}</a>
    </h2>
    {author.credentials && (
      <p class="m-0 text-xs uppercase tracking-wide" style="color:var(--color-muted)">{author.credentials}</p>
    )}
    <p class="m-0 text-sm">{author.bio}</p>
    {author.socialLinks.length > 0 && (
      <ul class="m-0 mt-1 flex list-none flex-wrap gap-3 p-0 text-sm">
        {author.socialLinks.map((s) => (
          <li><a href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</aside>
