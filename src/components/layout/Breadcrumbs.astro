---
/**
 * Visible breadcrumbs. The crumb list is passed in and must MATCH the
 * BreadcrumbList JSON-LD emitted on the same page (built from the same array in
 * the layout), so structured data reflects what the reader sees.
 */
export interface Crumb {
  name: string;
  href: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="m-0 flex flex-wrap list-none gap-1 p-0" style="color:var(--color-muted)">
    {crumbs.map((c, i) => {
      const last = i === crumbs.length - 1;
      return (
        <li class="flex items-center gap-1">
          {last ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={c.href}>{c.name}</a>
          )}
          {!last && <span aria-hidden="true">›</span>}
        </li>
      );
    })}
  </ol>
</nav>
