---
/**
 * Site footer: link groups, a quiet affiliate disclosure line, and copyright.
 */
import { SITE, FOOTER_NAV } from '@lib/site';
import AffiliateDisclosure from '../affiliate/AffiliateDisclosure.astro';

const year = new Date().getFullYear();
const groups = Object.entries(FOOTER_NAV);
---
<footer style="background:var(--color-surface);border-top:1px solid var(--color-rule)" class="mt-16">
  <div class="container-prose grid gap-8 py-10 sm:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div class="grid gap-2">
      <span class="text-lg font-extrabold" style="color:var(--color-petrol)">{SITE.name}</span>
      <p class="m-0 max-w-xs text-sm" style="color:var(--color-muted)">{SITE.description}</p>
    </div>
    {groups.map(([title, links]) => (
      <nav aria-label={title}>
        <h2 class="m-0 mb-2 text-xs uppercase tracking-wide" style="color:var(--color-muted)">{title}</h2>
        <ul class="m-0 grid list-none gap-1 p-0">
          {links.map((l) => (
            <li><a href={l.href} class="text-sm">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container-prose border-t py-5" style="border-color:var(--color-rule)">
    <AffiliateDisclosure variant="inline" />
    <p class="m-0 mt-3 text-xs" style="color:var(--color-muted)">
      © {year} {SITE.name}. Reviews are independent; product selection is never influenced by commissions.
    </p>
  </div>
</footer>
