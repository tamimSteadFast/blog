# ---------------------------------------------------------------------------
# Caliper Air — environment variables
# Copy this file to `.env` for local development and set the real values on
# your host for production. Variables prefixed with PUBLIC_ are exposed to the
# browser bundle, so NEVER put secrets (API keys, PA-API credentials) behind a
# PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# The production origin. REQUIRED for production builds — the build fails if it
# is missing or left as the placeholder. No trailing slash.
PUBLIC_SITE_URL=https://example.com

# Amazon Associates store/tracking tag used to build affiliate links.
# Placeholder until your Associates account is approved. US tags look like
# "yourname-20". You can define additional per-cluster tracking IDs below.
PUBLIC_AMAZON_TAG=caliperair-20

# Optional: per-cluster Associates tracking IDs, comma-separated as
# cluster:tag pairs. Lets the Associates earnings report be read by content
# group (see docs/MEASUREMENT_AND_OPTIMIZATION.md). Falls back to
# PUBLIC_AMAZON_TAG when a cluster is not listed. Verify extra tracking IDs are
# permitted in your marketplace's Associates Operating Agreement first.
# Example: air-purifiers:caliperair-main-20,use-cases:caliperair-usecase-20
PUBLIC_AMAZON_TAGS_BY_CLUSTER=

# Google Tag Manager container ID. Leave empty to render no analytics at all
# (GTM becomes a no-op). Never ship a fake ID to production.
PUBLIC_GTM_ID=
